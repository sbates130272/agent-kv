# syntax=docker/dockerfile:1
#
# vLLM serving image for gfx1250 (Radeon RX 9000 / RDNA 4).
#
# Builds on the rocm-bake pytorch base (ROCm 10.1.0 + Python 3.14 + PyTorch
# 2.15.0) and pip-installs vllm + lmcache from the rocm-bake PEP 503 wheel
# index.  Pairs with the lmcache image for LMCache-MP KV block offload.

ARG PYTORCH_IMAGE=snoc-strix.fold-leaffish.ts.net:8080/rocm-pytorch/pytorch:latest
FROM ${PYTORCH_IMAGE}

ARG WHEEL_INDEX=https://sbates130272.github.io/rocm-bake/data/wheels/gfx1250/
ARG VLLM_VERSION=0.33.0
ARG LMCACHE_VERSION=0.5.6

# amdsmi: expose the in-tree Python bindings to Python via a .pth file.
# /opt/rocm/share/amd_smi ships with the ROCm runtime but is not on sys.path.
RUN sp=$(python -c "import sysconfig; print(sysconfig.get_paths()['purelib'])") && \
    printf '/opt/rocm/share/amd_smi\n' > "${sp}/rocm-amdsmi.pth" && \
    python -c "import amdsmi; print('amdsmi ok:', amdsmi.__file__)"

# --ignore-requires-python: same cp314-dev marker caveat as Dockerfile.lmcache.
RUN pip install --no-cache-dir \
        --index-url "${WHEEL_INDEX}" \
        --extra-index-url https://pypi.org/simple \
        --ignore-requires-python \
        "vllm==${VLLM_VERSION}" \
        "lmcache==${LMCACHE_VERSION}" && \
    python -c "import vllm; print('vllm', vllm.__version__)"

# vLLM OpenAI-compatible endpoint
EXPOSE 8000

ENTRYPOINT ["vllm", "serve"]

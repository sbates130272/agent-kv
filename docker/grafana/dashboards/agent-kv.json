    },
    {
      "id": 62,
      "title": "LMCache coordinator \u2014 key directory",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 42,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "lmcache_coordinator_key_directory_placements",

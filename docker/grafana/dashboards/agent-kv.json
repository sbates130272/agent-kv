{
  "uid": "agent-kv-lmcache",
  "title": "agent-kv \u2014 vLLM + LMCache KV Benchmark",
  "description": "TTFT, throughput, KV cache hit rates, NVMe IO and queue depth for the agent-kv benchmark stack on gfx1201.",
  "tags": [
    "vllm",
    "lmcache",
    "kv-cache",
    "agent-kv"
  ],
  "timezone": "browser",
  "refresh": "auto",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Throughput",
      "id": 100,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "description": "Inference throughput metrics \u2014 requests per second and token generation rates."
    },
    {
      "id": 1,
      "title": "Requests / s",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "rate(vllm:request_success_total[1m])",
          "legendFormat": "{{job}} success/s"
        }
      ],
      "description": "Completed inference requests per second (HTTP 200 responses)."
    },
    {
      "id": 2,
      "title": "Token Throughput",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tok/s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "rate(vllm:generation_tokens_total[1m])",
          "legendFormat": "{{job}} gen tok/s"
        },
        {
          "expr": "rate(vllm:prompt_tokens_total[1m])",
          "legendFormat": "{{job}} prompt tok/s"
        }
      ],
      "description": "Prompt and generation token throughput in tokens per second."
    },
    {
      "id": 3,
      "title": "Queue Depth",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "vllm:num_requests_running",
          "legendFormat": "{{job}} running"
        },
        {
          "expr": "vllm:num_requests_waiting",
          "legendFormat": "{{job}} waiting"
        }
      ],
      "description": "Number of requests waiting in the vLLM scheduler queue."
    },
    {
      "type": "row",
      "title": "Latency",
      "id": 101,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "description": "End-to-end latency metrics for inference requests."
    },
    {
      "id": 10,
      "title": "TTFT \u2014 Time To First Token",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(vllm:time_to_first_token_seconds_bucket[1m]))",
          "legendFormat": "p50 {{job}}"
        },
        {
          "expr": "histogram_quantile(0.95, rate(vllm:time_to_first_token_seconds_bucket[1m]))",
          "legendFormat": "p95 {{job}}"
        },
        {
          "expr": "histogram_quantile(0.99, rate(vllm:time_to_first_token_seconds_bucket[1m]))",
          "legendFormat": "p99 {{job}}"
        }
      ],
      "description": "Time from request receipt to the first output token \u2014 dominated by prompt processing and KV cache lookup."
    },
    {
      "id": 11,
      "title": "TPOT \u2014 Time Per Output Token",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(vllm:request_time_per_output_token_seconds_bucket[1m]))",
          "legendFormat": "p50 {{job}}"
        },
        {
          "expr": "histogram_quantile(0.95, rate(vllm:request_time_per_output_token_seconds_bucket[1m]))",
          "legendFormat": "p95 {{job}}"
        },
        {
          "expr": "histogram_quantile(0.99, rate(vllm:request_time_per_output_token_seconds_bucket[1m]))",
          "legendFormat": "p99 {{job}}"
        }
      ],
      "description": "Average time per generated token after the first: (E2E \u2212 TTFT) / (output_tokens \u2212 1)."
    },
    {
      "id": 12,
      "title": "E2E Request Latency",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(vllm:e2e_request_latency_seconds_bucket[1m]))",
          "legendFormat": "p50 {{job}}"
        },
        {
          "expr": "histogram_quantile(0.95, rate(vllm:e2e_request_latency_seconds_bucket[1m]))",
          "legendFormat": "p95 {{job}}"
        },
        {
          "expr": "histogram_quantile(0.99, rate(vllm:e2e_request_latency_seconds_bucket[1m]))",
          "legendFormat": "p99 {{job}}"
        }
      ],
      "description": "Total end-to-end latency from request receipt to final token."
    },
    {
      "type": "row",
      "title": "KV Cache \u2014 vLLM + LMCache",
      "id": 102,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "description": "vLLM GPU KV cache state and LMCache external KV block hit rates and latencies."
    },
    {
      "id": 20,
      "title": "vLLM GPU KV Cache Utilisation",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 4,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "vllm:kv_cache_usage_perc",
          "legendFormat": "{{job}}"
        }
      ],
      "description": "Fraction of GPU VRAM currently used by the vLLM KV cache pool."
    },
    {
      "id": 21,
      "title": "LMCache External Hit Rate",
      "type": "gauge",
      "gridPos": {
        "x": 4,
        "y": 16,
        "w": 4,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "rate(vllm:external_prefix_cache_hits_total[1m]) / (rate(vllm:external_prefix_cache_queries_total[1m]) + 1e-9)",
          "legendFormat": "LMCache hit rate"
        }
      ],
      "description": "Fraction of prefix tokens served from LMCache (external KV store) rather than recomputed. Uses vLLM's external prefix cache counters."
    },
    {
      "id": 22,
      "title": "LMCache External Hits Vs Queries",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "rate(vllm:external_prefix_cache_hits_total[1m])",
          "legendFormat": "hits/s"
        },
        {
          "expr": "rate(vllm:external_prefix_cache_queries_total[1m])",
          "legendFormat": "queries/s"
        }
      ],
      "description": "Absolute token counts: LMCache hits vs total queries per second."
    },
    {
      "id": 23,
      "title": "LMCache MP Lookup Latency",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(vllm:lmcache_mp_lookup_duration_seconds_bucket[1m]))",
          "legendFormat": "p50 lookup"
        },
        {
          "expr": "histogram_quantile(0.95, rate(vllm:lmcache_mp_lookup_duration_seconds_bucket[1m]))",
          "legendFormat": "p95 lookup"
        },
        {
          "expr": "histogram_quantile(0.99, rate(vllm:lmcache_mp_lookup_duration_seconds_bucket[1m]))",
          "legendFormat": "p99 lookup"
        }
      ],
      "description": "Round-trip latency for vLLM to look up KV blocks in LMCache MP (p50/p95/p99). Includes NVMe read time when blocks are on the L2 tier."
    },
    {
      "id": 24,
      "title": "Cached Prompt Tokens (Prefix Cache)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tok/s",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "rate(vllm:prompt_tokens_cached_total[1m])",
          "legendFormat": "cached tok/s"
        },
        {
          "expr": "rate(vllm:prompt_tokens_total[1m])",
          "legendFormat": "total prompt tok/s"
        }
      ],
      "description": "Prefix KV tokens served from vLLM's internal GPU cache (APC) \u2014 reuse within a single vLLM instance across requests."
    },
    {
      "id": 25,
      "title": "KV Fetch Requests By Stage",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "vllm:num_requests_kv_fetch_by_stage",
          "legendFormat": "{{stage}}"
        }
      ],
      "description": "vLLM KV transfer scheduler state: requests waiting to start, in-progress fetches, and completed-but-waiting fetches."
    },
    {
      "type": "row",
      "title": "Block Device IO \u2014 $block_device (KV L2 Tier)",
      "id": 103,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "description": ""
    },
    {
      "id": 30,
      "title": "Block Device Throughput",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "rate(node_disk_read_bytes_total{device=\"$block_device\"}[1m])",
          "legendFormat": "read"
        },
        {
          "expr": "rate(node_disk_written_bytes_total{device=\"$block_device\"}[1m])",
          "legendFormat": "write"
        }
      ],
      "description": "Read and write throughput for the selected block device in bytes per second."
    },
    {
      "id": 31,
      "title": "Block Device IOPS",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "iops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "rate(node_disk_reads_completed_total{device=\"$block_device\"}[1m])",
          "legendFormat": "read IOPS"
        },
        {
          "expr": "rate(node_disk_writes_completed_total{device=\"$block_device\"}[1m])",
          "legendFormat": "write IOPS"
        }
      ],
      "description": "Read and write I/O operations per second for the selected block device."
    },
    {
      "id": 32,
      "title": "Block Device Latency (ms)",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ms"
        }
      },
      "targets": [
        {
          "expr": "1000 * rate(node_disk_read_time_seconds_total{device=\"$block_device\"}[1m]) / (rate(node_disk_reads_completed_total{device=\"$block_device\"}[1m]) + 1e-9)",
          "legendFormat": "avg read latency (ms)"
        },
        {
          "expr": "1000 * rate(node_disk_write_time_seconds_total{device=\"$block_device\"}[1m]) / (rate(node_disk_writes_completed_total{device=\"$block_device\"}[1m]) + 1e-9)",
          "legendFormat": "avg write latency (ms)"
        }
      ],
      "description": "Average I/O service latency in milliseconds for the selected block device. Includes dm-delay artificial latency when the dm-delay device is selected."
    },
    {
      "type": "row",
      "title": "AMD GPU \u2014 amd-smi-exporter",
      "id": 105,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "description": "AMD GPU hardware metrics from the amd-smi exporter running as a host service."
    },
    {
      "id": 50,
      "title": "GPU Utilisation",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "gpu_gfx_activity",
          "legendFormat": "GPU {{gpu}} gfx %"
        },
        {
          "expr": "gpu_umc_activity",
          "legendFormat": "GPU {{gpu}} mem %"
        }
      ],
      "description": "GFX engine and UMC (memory controller) activity percentage from amdsmi."
    },
    {
      "id": 51,
      "title": "VRAM Usage (MiB)",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 35,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mebibytes",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "gpu_used_vram",
          "legendFormat": "used MiB"
        },
        {
          "expr": "gpu_total_vram",
          "legendFormat": "total MiB"
        }
      ],
      "description": "Total and used VRAM in MiB \u2014 watch used VRAM to detect OOM pressure."
    },
    {
      "id": 52,
      "title": "GPU Power (W)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "gpu_average_package_power",
          "legendFormat": "avg package power (W)"
        }
      ],
      "description": "Average socket power and power limit in watts."
    },
    {
      "id": 53,
      "title": "GPU Temperature (\u00b0C)",
      "type": "timeseries",
      "gridPos": {
        "x": 18,
        "y": 35,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "gpu_junction_temperature",
          "legendFormat": "junction \u00b0C"
        }
      ],
      "description": "GPU junction temperature in Celsius."
    },
    {
      "type": "row",
      "title": "LMCache Server + Coordinator",
      "id": 106,
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "description": "LMCache MP server and coordinator internals \u2014 cache tiers, prefetch, key directory."
    },
    {
      "id": 60,
      "title": "LMCache Store/Retrieve Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "rate(lmcache_mp_l1_write_chunks_total[1m])",
          "legendFormat": "store chunks/s (L1)"
        },
        {
          "expr": "rate(lmcache_mp_l1_read_chunks_total[1m])",
          "legendFormat": "retrieve chunks/s (L1)"
        }
      ],
      "description": "LMCache L1 (host RAM) chunk store and retrieve rates in chunks per second."
    },
    {
      "id": 61,
      "title": "LMCache Cache Occupancy",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 42,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "lmcache_mp_l1_write_chunks_total - lmcache_mp_l1_evicted_chunks_total",
          "legendFormat": "L1 live chunks"
        },
        {
          "expr": "lmcache_mp_l2_usage_bytes",
          "legendFormat": "L2 used bytes"
        }
      ],
      "description": "L1 live chunk count (writes minus evictions) and L2 NVMe tier utilisation in bytes."
    },
    {
      "id": 62,
      "title": "LMCache Coordinator \u2014 Key Directory",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 42,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "lmcache_coordinator_key_directory_placements",
          "legendFormat": "placements {{tier}}"
        },
        {
          "expr": "lmcache_coordinator_key_directory_placement_bytes",
          "legendFormat": "bytes {{tier}}"
        }
      ],
      "description": "LMCache coordinator key-directory state: chunk placements and bytes tracked per tier."
    },
    {
      "type": "row",
      "title": "System \u2014 CPU / Memory / Network",
      "id": 104,
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "description": "Host-level CPU, memory, and network metrics from node-exporter."
    },
    {
      "id": 40,
      "title": "CPU Utilisation",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {

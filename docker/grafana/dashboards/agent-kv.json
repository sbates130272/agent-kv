        {
          "expr": "lmcache_coordinator_key_directory_placement_bytes",
          "legendFormat": "bytes {{tier}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "System \u2014 CPU / Memory / Network",
      "id": 104,
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 40,
      "title": "CPU utilisation",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))",
